<!DOCTYPE html>
<html lang="en" data-theme=""dark>
    <head>
        <meta charset = "UTF-8">
        <meta name = "viewport" content = "width=device-width, initial-scale=1.0">
        <title>CK-Developer, Designer &amp; Builder</title>
        <meta name = "description" content="The Personal website of CK: who I am, my journey, my skills, awards, projects, and an interactive webpage to explore it all.">
        <meta name="theme-color" content = "#07070d">
        <meta name="author" content="CK">
        <meta property="og:type" content="webiste">
        <meta property ="og:title" content = "Ck - Developer, Designer & Builder">
        <meta property = "og:description" content = "My journey, skills, awards and projects - all in one place.">
        <link rel = "icon" href="data:image/svg+xml,%3Csvg xmlns = 'http://www.w3.org/2000/svg' viewBox = '0 0 100 100 '%3E%3Cdefs%3E%3ClinearGradient id 'g' x1 = '0' y1 = '0' x2 = '1' y2 = '1'%3E%3Cstop offset = '0' stop-color='%237c5cff'/%3E%3Cstop offset='1' stop-color='%2322d3ee'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='100' height='100' rx='24' fill='url(%23g)'/%3E%3Ctext x='50' y='64' font-size='42' text-anchor='middle' fill='white' font-family='Arial' font-weight='700'%3ECK%3C/text%3E%3C/svg%3E">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnet" href = "https://fonts.gstatic.com" crossorigin>
        <link href = "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel = "stylesheet">

        <script>
            (function (){
                try{
                    var saved = localStorage.getItem('ck-theme'); 
                    var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
                    document.documentElement.setAttribute('data-theme', saved || (prefersLight ? 'light' : 'dark'));

                }catch(e){}
            })();
        </script>
        <style>
            :root{
            --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI' Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono' Menlo, Consolas, monospace;

            --bg: #07070d;
            --bg-elevated: #0d0d17;
            --bg-overlay: rgba(7, 7, 13, 0.72);
            --surface: rgba(255,255,255, 0.035);
            --surface-strong: rgba(255, 255, 255, 0,07);
            --surface-hover: rgba(255, 255, 255, 0.09);
            --border: rgba(255, 255, 255, 0.08);
            --border-strong: rgba(255, 255, 255, 0.16);

            --txt: #ececf4;
            --text-muted: #a0a0b8;
            --text-faint: #62627c;
            --accent-1: hsl(250, 93%, 33%);
            --accent-2: hsl(189,90%,55%);
            --accent-3: hsl(330, 85%, 65%);
            --accent-4: hsl(42, 95%, 60%);
            --success: hsl(152, 68%, 50%);
            --danger: hsl(0, 80%, 64%);

            --gradient: linear-gradient(135deg, var(--accent-1) 0%, var(--accent-2) 100%);
            --gradient-warm: linear-gradient(135deg, var(--accent-3) 0%, var(--accent-4)100%);
            --gradient-full: linear-gradient(90deg, var(--accent-1), var(--accent-2), var(--accent-3), var(--accent-1));

            --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
            --shadow-md: 0 10px 30px rgba(0,0,0,0.35);
            --shadow-lg: 0 24px 60px rgba(0,0,0,0.5);
            --shadow-glow: 0 0 40px hsla(259, 90%, 68%, 0.35);

            --heat-0: rgba(255, 255, 255, 0.05);
            --heat-1: hsla(258, 90%, 68%, 0.28);
            --heat-2: hsla(258, 90%, 68%, 0.5);
            --heat-3: hsla(230, 90%, 64%, 0.75);
            --heat-4: hsla(189, 90%, 55%);

            --radius-sm:8px;
            --radius: 14px;
            --radius-lg: 22px;
            --radius-full: 999px;

            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
            --dur-fast: 150ms;
            --dur: 300ms;
            --dur-slow: 700ms;

            --nav-h: 72px;
            --container: 1180px;

            color-scheme: dark;
        }

        [data-theme="light"]{
         --bg: #f6f6fb;
         --bg-elevated: #ffffff;
         --bg-overlay: rgba(246, 246, 251, 0.78);
         --surface: rgba(20, 20, 50, 0.035); 
         --surface-strong: rgba(20, 20, 50, 0.06);
         --surface-hover: rgba(20, 20, 50, 0.08);
         --border: rgba(20,20, 50, 0.09);
         --border-strong: rgba(20, 20, 50, 0.18);

         --text: #15151f;
         --text-muted: #55556c;
         --text-faint: #9a9ab0;

         --accent-1: hsl(231, 87%, 25%);
         --accent-2: hsl(193, 90%, 40%);
         --accent-3: hsl(330, 75%, 52%);
         --accent-4: hsl(36, 95%, 48%);

         --shadow-sm: 0 2px 8px rgba(30, 30, 80, 0.06);
         --shadow-md: 0 10px 30px rgba(30, 30, 80, 0.08);
         --shadow-lg: 0 24px 60px rgba(30, 30, 80, 0.1);
         --shadow-glow: 0 0 40px hsla(258, 78%, 56%, 0.2);

         --heat-0: rgba(20, 20, 50, 0.06);
         --heat-1: hsla(258, 78%, 56%, 0.25);
         --heat-2: hsla(258, 78%, 56%, 0.48);
         --heat-3: hsla(230, 80%, 52%, 0.72);
         --heat-4: hsla(193, 90%, 40%);

         color-scheme: light;
        }

        *,
        *::before,
        *::after{
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html{
            scroll-behavior: smooth;
            scroll-padding-top: calc(var(--nav-h) + 16px);
            -webkit-text-size-adjust: 100%;
        }

        body{
            font-family: var(--font-sans);
            font-size: 16px;
            line-height: 1.65;
            color: var(--text);
            background: var(--bg);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color var(--dur) var(--ease), color var(--dur) var (--ease);
        }

        body.no-scroll{
            overflow: hidden;
        }

        img,
        svg,
        canvas{
            display: block;
            max-width: 100%;
        }

        a{
            color: inherit;
            text-decoration: none;
        }

        button,
        input{
            font: inherit;
            color: inherit;
        }

        button{
            cursor: pointer;
            background: none;
            border: none;
        }

        ::selection{
            background: hsla(258, 90%, 68%, 0.35);
            color: var(--text);
        }

        ::focus-visible{
            outline: 2px solid var(--accent-2);
            outline-offset: 3px;
            border-radius: 6px;
        }
        
        ::-webkit-scrollbar{
            width: 10px;
            height: 10px;
        }
        ::-webkit-scrollbar-track{
            background: var(--bg);
        }

        ::-webkit-scrollbar-thumb{
            background: var(--surface-hover);
            border: 2px solid var(--bg);
            border-radius: var(--radius-full);
        }

        ::-webkit-scrollbar-thumb:hover{
            background: var(--accent-1);
        }

        .sr-only{
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .skip-link{
            position: fixed;
            top: -100px;
            left: 16px;
            z-index: 1000;
            padding: 10px 16px;
            background: var(--accent-1);
            color: #fff;
            border-radius: var(--radius-sm);
            font-weight: 600;
            transition: top var(--dur) var(--ease);
        }

        .skip-link:focus{
            top: 16px;
        }

        .container{
            width: min(var(--container), 100% - 48px);
            margin-inline: auto;
        }

        .gradient-text{
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .mono{
            font-family: var(--font-mono);
        }

        kbd{
            font-family: var(--font-mono);
            font-size: 0.75em;
            padding: 2px 6px;
            border-radius: 6px;
            background: var(--surface-strong);
            border: 1px solid var(--border-strong);
            border-bottom-width: 2px;
            color: var(--text-muted);
        }

        /*for the ambient background and the cursor glow and scroll progress */
        .ambient{
            position: fixed;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            overflow: hidden;
        }

        .ambient_blob{
            position: absolute;
            width:50vmax;
            height: 50vmax;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.18;
            animation: blob-float 26s var(--ease) infinite alternate;
        }

        .ambient_blob--1{
            top: -20vmax;
            left: -10vmax;
            background: var(--accent-1);
        }

        .ambient_blob--2{
            top: 20h;
            right: -20vmax;
            background: var(--accent-2);
            animation-delay: -8s;
        }

        .ambient_blob--3{
            bottom: -25vmax;
            left: 20vw;
            background: var(--accent-3);
            animation-delay: -16s;
            opacity: 0.12;
        }

        [data-theme="light"] .ambient_blob{
            opacity: 0.1;
        }

        .ambient_grid{
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(var(--border) 1px, transparent 1px),
                linear-gradient(90deg, var(--border) 1px, transparent 1px);
            background-size: 64px 64px;
            mask-image: radial-gradient(ellspse at 50% 0%, black 0%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
            opacity: 0.5;    
        }

        @keyframes blob-float{
            0%{
                transform: translate(0,0) scale(1);
            }
            50%{
                transform: translate(6vw, 4vh) scale(1,1);
            }
            100%{
                transform: translate(-4vw, 8vh) scale(0.95);
            }
        }

        .cursor-glow{
            position: fixed;
            top: 0;
            left: 0;
            width: 480px;
            height: 480px;
            margin: -240px 0 0 -240px;
            border-radius: 50%;
            background: radial-gradient(circle, hsla(358, 90%, 68%, 0.12) 0%, transparent 65%);
            pointer-events: none;
            z-index: -1;
            opacity: 0;
            transition: opactiy var(--fur-slow) var(--ease);
            will-change: transform;
        }

        .cursor-glow.is-active{
            opacity: 1;
        }

        @media (pointer: coarse){
            .cursor-glow{
                display: none;
            }
        }

        .scroll-prgress{
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            width: 100%;
            z-index: 200;
            transform-origin: 0 50%;
            transform: scaleX(0);
            background-size: 200% 100%;
            animation: gradient-pan 6s linear infinte;
        }

        @keyframes gradient-pan{
            to{
                background-position: 200% 0;
            }
        }

        /* navigation styles next */
        .nav{
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            height: var(--nav-h);
            display: flex;
            align-items: center;
            transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), height var(--dur) var(--ease);
        }

        .nav.is-scrolled{
            --nav-h:60px;
            background: var(--bg-overlay);
            backdrop-filter: blur(18px) saturate(160%)
            border-bottom-color: var(--border);
        }
        .nav_logo{
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
        }

        .nav_logo-mark{
            display: grid;
            place-items:center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--gradient);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 800;
            box-shadow: var(--shadow-glow);
            transition: transform var(--dur) var(--ease-bounce);
        }

        .nav_logo-mark{
            transform: rotate(-8deg) scale(1.08);
        }

        .nav_links{
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
        }

        .nav_link:hover{
            color: var(--text);
            background: var(--surface-strong);
        }

        .nav_link.is-active::after{
            content: '';
            position: absolute;
            left: 50%;
            bottom: 2px;
            width: 5px;
            height: 5px;
            margin-left: -2.5px;
            border-radius: 50%;
            background: var(--graident);
        }

        .nav_actions{
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn{
            display: grid;
            place-items: center;
             width: 40px;
             height: 40px;
             border-radius: var(--radius-full);
             border: 1px solid var(--border);
             background: var(--text-muted);
             color: var(--text-muted);
             transition: all var(--dur-fast) var(--ease);
        }
        </style>

    </head>
</html>
